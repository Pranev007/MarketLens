# ---------------------------------------------------------------------------
# MarketLens configuration
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL connection -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketlens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: a full SQLAlchemy URL. When set it overrides the settings above.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marketlens

# --- Where the analytics layer reads from ----------------------------------
#   parquet   -> read the cleaned files in data/processed  (no database needed)
#   postgres  -> read from PostgreSQL
#   auto      -> use PostgreSQL when reachable, otherwise fall back to parquet
MARKETLENS_SOURCE=auto

# --- Source data -----------------------------------------------------------
# The Brazilian E-Commerce Public Dataset by Olist, downloaded into
# data/raw/olist by `python -m marketlens.data_ingestion`. Nothing is
# generated: every figure in the reports comes from that extract.
#
# The downloader uses the Kaggle API when ~/.kaggle/kaggle.json (or
# KAGGLE_USERNAME / KAGGLE_KEY) is present, and a public mirror otherwise.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Reporting window ------------------------------------------------------
# Analysis runs over 2017-01-01 to 2018-08-31, which holds 99.65% of orders.
# Set this to 1 to include the sparse tail months either side instead.
# MARKETLENS_FULL_WINDOW=0
